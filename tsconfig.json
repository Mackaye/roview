{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/cli/src/**/*.ts", "apps/companion/src/**/*.ts", "apps/mcp/src/**/*.ts", "apps/setup/src/**/*.ts", "packages/**/*.ts"]
}
